generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String   @default("")
  company     String   @default("")
  location    String   @default("")
  tags        String   @default("")
  lastMessage String   @default("")
  status      String   @default("active")
  score       Int      @default(50)
  segments    String   @default("")
  dateAdded   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campaign {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("scheduled")
  total     Int      @default(0)
  sent      Int      @default(0)
  delivered Int      @default(0)
  replies   Int      @default(0)
  message   String   @default("")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutoReplyRule {
  id        String   @id @default(cuid())
  trigger   String
  response  String
  matchType String   @default("contains")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatbotFlow {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  nodes       String   @default("[]")
  active      Boolean  @default(false)
  triggers    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ScheduledMessage {
  id         String   @id @default(cuid())
  message    String
  recipients String   @default("")
  date       String
  time       String
  recurring  String   @default("none")
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MessageTemplate {
  id          String   @id @default(cuid())
  name        String
  content     String
  category    String   @default("general")
  starred     Boolean  @default(false)
  variables   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id          String   @id @default(cuid())
  contactId   String   @default("")
  contactName String   @default("")
  direction   String   @default("incoming")
  content     String
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model PersonalityProfile {
  id              String   @id @default(cuid())
  tone            String   @default("professional")
  style           String   @default("concise")
  language        String   @default("english")
  greetingStyle   String   @default("hello")
  closingStyle    String   @default("thanks")
  emojiUsage      String   @default("minimal")
  formalityLevel  Int      @default(5)
  responsePatterns String  @default("")
  samplePhrases   String   @default("")
  lastTrainedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LeadSearch {
  id              String   @id @default(cuid())
  keyword         String
  location        String   @default("")
  results         String   @default("[]")
  resultCount     Int      @default(0)
  phoneCount      Int      @default(0)
  whatsappCount   Int      @default(0)
  sourceBreakdown String   @default("{}")
  mode            String   @default("quick")
  deepScan        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model WhatsAppGroup {
  id          String   @id @default(cuid())
  name        String
  inviteLink  String   @default("")
  description String   @default("")
  category    String   @default("")
  members     Int      @default(0)
  source      String   @default("")
  sourceName  String   @default("")
  saved       Boolean  @default(false)
  keyword     String   @default("")
  location    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

model Flow {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  nodes       String   @default("[]")
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  email       String
  role        String   @default("agent")
  permissions String   @default("[]")
  avatarColor String   @default("#8b5cf6")
  isOnline    Boolean  @default(false)
  lastActive  String   @default("Never")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
